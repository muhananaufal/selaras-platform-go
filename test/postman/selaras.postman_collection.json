                  "pm.test(\"kurikulum sudah ada\", () => pm.expect(weeks.length).to.be.above(0));",
                  "const task = weeks.flatMap(w => w.tasks || []).find(t => t.id);",
                  "if (task) pm.collectionVariables.set(\"taskId\", task.id);"
                ]
              }
            }
