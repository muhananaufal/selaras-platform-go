# Salin ke .env dan isi. Tidak ada nilai bawaan untuk kredensial:
# aplikasi dan container sengaja menolak start bila kosong (ADR-016).

# ---------------------------------------------------------------- postgres
POSTGRES_USER=selaras_admin
POSTGRES_PASSWORD=
POSTGRES_DB=selaras
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

# Kredensial per service. Satu role per schema, sesuai ADR-006.
SVC_IDENTITY_PASSWORD=
SVC_PROFILE_PASSWORD=
SVC_ASSESSMENT_PASSWORD=
SVC_COACHING_PASSWORD=
SVC_CHAT_PASSWORD=
SVC_NUTRITION_PASSWORD=
SVC_DASHBOARD_PASSWORD=
SVC_LLM_PASSWORD=

# ---------------------------------------------------------------- kafka
KAFKA_BROKERS=localhost:19092

# ---------------------------------------------------------------- redis
REDIS_ADDR=localhost:16379

# ---------------------------------------------------------------- llm
# Dikirim lewat header, tidak pernah ditempel ke URL (menutup S7).
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------------------------------------------------------------- auth
# Kunci token. Keduanya WAJIB berpasangan - hasilkan dengan `task keygen`,
# yang mencetak keduanya sekaligus supaya tidak mungkin tidak cocok.
#
# JWT_SIGNING_KEY adalah seed Ed25519 32 byte base64, dipegang HANYA oleh
# identity-svc. JWT_VERIFY_KEY adalah kunci publiknya, dipegang gateway -
# yang karena itu bisa memverifikasi token dan tidak bisa menerbitkannya
# (ADR-020).
JWT_SIGNING_KEY=
JWT_VERIFY_KEY=

# Umur token akses. Detik polos atau durasi bergaya Go.
JWT_ACCESS_TTL=3600

# ---------------------------------------------------------------- telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14317
OTEL_SERVICE_NAME=
LOG_LEVEL=info

# Masuk lewat penyedia sosial. Kosongkan SEMUANYA untuk mematikannya - rutenya
# tidak akan dipasang. Mengisi sebagian menggagalkan start-up dengan sengaja:
# client id tanpa secret akan menyalakan rutenya lalu gagal di pertukaran.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
FRONTEND_URL=

# Pengiriman surel. Kosongkan SEMUANYA untuk mematikannya - reset kata sandi
# akan menolak dengan menyebut apa yang kurang. Mengisi sebagian menggagalkan
# start-up.
#
# Compose mengarahkannya ke Mailpit secara bawaan, yang menangkap seluruh
# surel dan menyajikannya di http://127.0.0.1:18025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@selaras.local
